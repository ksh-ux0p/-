/* ---------- 획순 위젯 ---------- */
function makeWriter(boxId){
  const box=$(boxId);let w=null,tok=0,ctx=null,free=false,drawing=false;
  const dark=()=>document.documentElement.classList.contains('dark');
  function fallback(char,msg){
    if(box.querySelector('[data-fb]'))return;w=null;free=false;
    box.innerHTML=`<div data-fb class="hj text-[150px] font-black text-indigo-600 dark:text-indigo-400 select-none transition-opacity leading-none">${esc(char)}</div>
      <div class="absolute bottom-2 inset-x-0 text-center pointer-events-none"><span class="text-[10px] text-slate-400 bg-slate-200/80 dark:bg-slate-800/80 px-2.5 py-0.5 rounded-full">${esc(msg||'획순 미지원 한자')}</span></div>
      <canvas width="260" height="260" class="absolute inset-0 touch-none pointer-events-none"></canvas>`;
    const cv=box.querySelector('canvas');ctx=cv.getContext('2d');
    const pos=e=>{const r=cv.getBoundingClientRect(),p=e.touches?e.touches[0]:e;return{x:p.clientX-r.left,y:p.clientY-r.top}};
    const start=e=>{if(!free)return;drawing=true;const p=pos(e);ctx.beginPath();ctx.moveTo(p.x,p.y)};
    const draw=e=>{if(!drawing||!free)return;e.preventDefault();const p=pos(e);ctx.strokeStyle=dark()?'#818cf8':'#4f46e5';ctx.lineWidth=4;ctx.lineCap='round';ctx.lineJoin='round';ctx.lineTo(p.x,p.y);ctx.stroke()};
    const stop=()=>{drawing=false};
    cv.addEventListener('mousedown',start);cv.addEventListener('mousemove',draw);cv.addEventListener('mouseup',stop);cv.addEventListener('mouseleave',stop);
    cv.addEventListener('touchstart',start,{passive:false});cv.addEventListener('touchmove',draw,{passive:false});cv.addEventListener('touchend',stop);
  }
  return{
    show(char){
      const t=++tok;w=null;free=false;ctx=null;box.innerHTML='';
      try{w=HanziWriter.create(box,char,{width:260,height:260,padding:10,strokeColor:dark()?'#818cf8':'#4f46e5',outlineColor:dark()?'#334155':'#cbd5e1',showOutline:true,strokeAnimationSpeed:1.3,delayBetweenStrokes:200,onLoadCharDataError:()=>{if(t===tok)fallback(char)}});w.animateCharacter()}
      catch(e){fallback(char,'획순 기능을 불러오지 못했어요');return}
      if(typeof HanziWriter.loadCharacterData==='function')HanziWriter.loadCharacterData(char).catch(()=>{if(t===tok)fallback(char)});
    },
    anim(){
      if(w){w.cancelQuiz&&w.cancelQuiz();w.animateCharacter();return}
      free=false;if(ctx)ctx.clearRect(0,0,260,260);
      const c=box.querySelector('[data-fb]');if(c)c.style.opacity='1';const cv=box.querySelector('canvas');if(cv)cv.classList.add('pointer-events-none');
      toast('획순 애니메이션을 지원하지 않는 한자입니다.');
    },
    quiz(){
      if(w){w.quiz({showOutline:true,outlineColor:dark()?'#334155':'#cbd5e1',strokeColor:dark()?'#818cf8':'#4f46e5',onComplete:()=>toast('🎉 정확하게 잘 쓰셨습니다!')});toast('흐릿한 한자 선을 따라 덧써보세요!');return}
      free=true;if(ctx)ctx.clearRect(0,0,260,260);
      const c=box.querySelector('[data-fb]');if(c)c.style.opacity='0.2';const cv=box.querySelector('canvas');if(cv)cv.classList.remove('pointer-events-none');
      toast('연하게 표시된 한자 위에 직접 덧써보세요!');
    },
    stop(){tok++}
  };
}

