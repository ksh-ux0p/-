function dueumVariants(s){
  const out=new Set([s]);if(!s)return[...out];const c=s.charCodeAt(0);if(c<0xAC00||c>0xD7A3)return[...out];
  const code=c-0xAC00,ini=Math.floor(code/588),med=Math.floor((code%588)/28),fin=code%28;
  const mk=i=>out.add(String.fromCharCode(0xAC00+i*588+med*28+fin)+s.slice(1));
  if(ini===11&&[2,6,7,12,17,20].includes(med)){mk(2);mk(5)}
  if(ini===2&&[0,1,8,11,13,18].includes(med))mk(5);
  return[...out];
}
function getFilteredItems(){
  const q=$('f-q').value.trim(),st=$('f-status').value,vs=q?dueumVariants(q):[];
  return S.items.filter(i=>(activeFolderId==='all'||i.folder===activeFolderId)&&(st!=='u'||!i.learned)&&(st!=='l'||i.learned)&&(st!=='b'||i.mark)&&(!q||i.char.includes(q)||i.meaning.includes(q)||vs.some(v=>i.sound.includes(v)||(i.alt||'').includes(v))));
}
