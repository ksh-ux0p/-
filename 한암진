  $('w-title').textContent=w?'단어 수정':'단어 추가';
  $('w-word').value=w?w.word:'';$('w-read').value=w?w.reading:'';$('w-mean').value=w?w.meaning:'';$('w-ex').value=w?(w.ex||''):'';
  readAuto=!w||w.reading===autoRead(w.word);toggleFind(false);$('w-find').value='';findHanja();$('m-word').classList.add('open');$('w-word').focus();
}
function autoFillWord(){const w=$('w-word').value.trim();if(w&&(readAuto||!$('w-read').value.trim()))$('w-read').value=autoRead(w)}
let findRes=[];
function toggleFind(force){const b=$('w-find-box'),on=force!==undefined?force:b.classList.contains('hidden');b.classList.toggle('hidden',!on);if(on)$('w-find').focus()}
function findHanja(){
  const q=$('w-find').value.trim();findRes=q?localSearch(q).slice(0,40):[];
  $('w-chips').innerHTML=!q?'<span class="text-xs text-slate-400">음(학)이나 뜻(배울)을 입력해 고르세요</span>':!findRes.length?'<span class="text-xs text-slate-400">결과가 없어요</span>'
    :findRes.map((d,k)=>`<button type="button" onclick="pickHanja(${k})" class="px-2.5 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-center hover:border-indigo-500"><div class="hj text-2xl font-black text-indigo-600 dark:text-indigo-400 leading-none">${esc(d.char)}</div><div class="text-[10px] text-slate-500 mt-1">${esc(hx(d).m[0])} ${esc(d.sound)}</div></button>`).join('');
}
function pickHanja(k){const d=findRes[k];if(!d)return;$('w-word').value+=d.char;autoFillWord();$('w-find').value='';findHanja();$('w-find').focus()}
function wordBack(){const i=$('w-word');i.value=[...i.value].slice(0,-1).join('');if(i.value)autoFillWord();else if(readAuto)$('w-read').value=''}
function wordFolder(){let f=S.folders.find(x=>x.id===S.wordFolderId);if(!f){f={id:'f'+Date.now(),name:'단어 한자'};S.folders.push(f);S.wordFolderId=f.id}return f}
function syncWordHanja(word){
  let added=0;const missing=[];
  [...new Set(word)].forEach(c=>{if(!/[㐀-鿿]/.test(c)||S.items.some(i=>i.char===c))return;const d=DB.find(x=>x.char===c);if(!d){missing.push(c);return}if(add(d,wordFolder().id))added++});
  return{added,missing};
}
function saveWord(){
  const word=$('w-word').value.trim(),meaning=$('w-mean').value.trim(),reading=$('w-read').value.trim()||autoRead(word),ex=$('w-ex').value.trim();
  if(!word)return toast('단어를 입력하세요.');if(!meaning)return toast('뜻을 입력하세요.');
  if(S.words.some(x=>x.word===word&&x.id!==editWid))return toast('이미 등록된 단어입니다.');
  if(editWid)Object.assign(S.words.find(x=>x.id===editWid),{word,reading,meaning,ex});
  else S.words.unshift({id:'w'+Date.now()+Math.random().toString(36).slice(2,6),word,reading,meaning,ex,learned:false,mark:false});
  const r=syncWordHanja(word);save();fillFolders();closeM('m-word');render();
  toast('단어가 저장되었습니다.'+(r.added?` 한자 ${r.added}개를 '단어 한자' 폴더에 추가했어요.`:'')+(r.missing.length?` (DB에 없는 한자: ${r.missing.join('')})`:''));
}
const exList=w=>String(w.ex||'').split('\n').map(s=>s.trim()).filter(Boolean);
const exHtml=w=>{const L=exList(w);if(!L.length)return'';
  return '<div class="text-xs font-bold text-slate-400 pt-2">📖 예문</div>'+L.map(s=>`<div class="text-sm p-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 leading-relaxed">${esc(s).split(esc(w.word)).join('<b class="text-indigo-500">'+esc(w.word)+'</b>')}</div>`).join('')};
const exN=w=>exList(w).length?`<div class="text-center text-[10px] text-indigo-400 mt-1">📖 예문 ${exList(w).length}개</div>`:'';
const wdChars=()=>{const w=S.words.find(x=>x.id===curWid);return w?[...w.word].filter(c=>/[㐀-鿿]/.test(c)):[]};
function openWd(id){
  const w=S.words.find(x=>x.id===id);if(!w)return;curWid=id;wdIdx=0;WW=WW||makeWriter('ww');
  $('wd-word').textContent=w.word;$('wd-read').textContent=w.reading;$('wd-mean').textContent=w.meaning;$('wd-ex').innerHTML=exHtml(w);
  wdMarks();wdTiles();$('m-wd').classList.add('open');wdPick(0);
}
function wdMarks(){const w=S.words.find(x=>x.id===curWid);if(!w)return;$('wd-mark').className=w.mark?'text-amber-400':'';$('wd-learn').className=w.learned?'text-emerald-500 font-bold':''}
function wdTiles(){
  const cs=wdChars();
  $('wd-chars').innerHTML=cs.length?cs.map((c,k)=>{const d=DB.find(x=>x.char===c);
    return `<button onclick="wdPick(${k})" class="w-20 py-3 rounded-xl border text-center ${k===wdIdx?'border-indigo-500 bg-indigo-50 dark:bg-indigo-950/50':'border-slate-200 dark:border-slate-700'}">
      <div class="hj text-3xl font-black text-indigo-600 dark:text-indigo-400">${esc(c)}</div><div class="text-xs font-bold truncate px-1 mt-1">${d?esc(hx(d).m[0]+' '+d.sound):'정보 없음'}</div></button>`}).join(''):'<span class="text-xs text-slate-400">한자가 없는 단어입니다.</span>';
}
function wdPick(k){
  const cs=wdChars();if(!cs.length){$('ww').innerHTML='';$('wd-cinfo').textContent='';return}
  wdIdx=Math.min(k,cs.length-1);const c=cs[wdIdx],d=DB.find(x=>x.char===c);wdTiles();
  $('wd-cinfo').innerHTML=d?hxHtml(d,true):'<span class="text-xs text-slate-400">내장 DB에 없는 한자</span>';WW.show(c);
}
function wdTog(k){const w=S.words.find(x=>x.id===curWid);if(!w)return;w[k]=!w[k];save();wdMarks();render()}
function wdEdit(){const id=curWid;closeWd();openWord(id)}
function wdDel(){delWord(curWid)}
function closeWd(){if(WW)WW.stop();closeM('m-wd');render()}

/* ---------- 퀴즈 ---------- */
let QZ=null;
const lab=r=>r.meaning.split(',')[0]+' '+r.sound;
const wqLab=(w,m)=>m==='m2w'?w.word:m==='w2r'?w.reading:w.meaning;
function prepQuiz(){
  const hj=nav.sec==='hanja';quizTok++;
  show('qz-cfg',true);show('qz-play',false);show('qz-res',false);
  $('qz-title').textContent=hj?'한자 퀴즈':'단어 퀴즈';show('qz-w-folder',hj);show('qz-w-mode',!hj);
  if(hj)$('q-folder').innerHTML=folderOpts(true);
  const bad=!hj&&S.words.length<4;show('qz-warn',bad);$('qz-warn').textContent='단어가 4개 이상 있어야 퀴즈를 낼 수 있어요.';
  $('qz-start').disabled=bad;$('qz-start').classList.toggle('opacity-50',bad);
}
function mkHanja(it){
  const w=new Set(),right=lab(it);
  while(w.size<3){const d=DB[Math.floor(Math.random()*DB.length)];if(d.char!==it.char&&lab(d)!==right)w.add(lab(d))}
  return{src:it,big:it.char,bigCls:'hj text-7xl text-indigo-500',hint:'이 한자의 훈·음은?',ch:shuffle([...w,right]),right,chCls:'text-sm'};
}
function mkWord(w,mode){
  const right=wqLab(w,mode),seen=new Set([right]),ds=[],m2w=mode==='m2w';
  for(const x of shuffle(S.words.filter(x=>x.id!==w.id))){const l=wqLab(x,mode);if(l&&!seen.has(l)){seen.add(l);ds.push(l);if(ds.length===3)break}}
  return{src:w,big:m2w?w.meaning:w.word,bigCls:m2w?'text-2xl text-indigo-500':'hj text-6xl text-indigo-500',
    hint:mode==='w2m'?'이 단어의 뜻은?':mode==='w2r'?'이 단어의 독음은?':'이 뜻에 해당하는 한자 단어는?',ch:shuffle([...ds,right]),right,chCls:m2w?'hj text-xl':'text-sm'};
}
function buildQuiz(sec,pool,mode){
  const list=pool.map(x=>sec==='hanja'?mkHanja(x):mkWord(x,mode)).filter(q=>q.ch.length>=2);
  if(!list.length)return toast('보기를 만들 수 있는 항목이 부족해요.');
  QZ={sec,mode,list,i:0,s:0,wrong:[]};quizTok++;show('qz-cfg',false);show('qz-res',false);show('qz-play',true);qzShow();
}
function startQuiz(){
  const sc=$('q-scope').value,nv=$('q-n').value,mode=$('q-mode').value;let pool;
  if(nav.sec==='hanja'){const fo=$('q-folder').value;pool=S.items.filter(i=>(!fo||i.folder===fo)&&(sc!=='u'||!i.learned)&&(sc!=='b'||i.mark))}
  else{if(S.words.length<4)return toast('단어가 4개 이상 있어야 퀴즈를 낼 수 있어요.');pool=S.words.filter(w=>(sc!=='u'||!w.learned)&&(sc!=='b'||w.mark))}
  if(!pool.length)return toast('퀴즈로 낼 항목이 없습니다.');
  buildQuiz(nav.sec,shuffle(pool).slice(0,nv==='all'?pool.length:Math.min(pool.length,parseInt(nv,10))),mode);
}
function qzShow(){
  const q=QZ.list[QZ.i];
  $('qz-prog').textContent=`문제 ${QZ.i+1} / ${QZ.list.length}`;$('qz-score').textContent=`정답 ${QZ.s}`;$('qz-bar').style.width=(QZ.i/QZ.list.length*100)+'%';
  $('qz-hint').textContent=q.hint;const el=$('qz-big');el.textContent=q.big;el.className=q.bigCls+' font-black text-center py-5 break-all';
  $('qz-ch').innerHTML=q.ch.map((c,k)=>`<button class="${q.chCls} p-3 rounded-2xl border border-slate-200 dark:border-slate-700 font-bold text-left hover:border-indigo-500 flex gap-2" onclick="qzAns(${k})"><span class="text-[10px] text-slate-400 mt-1">${k+1}</span><span>${esc(c)}</span></button>`).join('');
}
function qzAns(k){
  const q=QZ&&QZ.list[QZ.i],bs=document.querySelectorAll('#qz-ch button');if(!q||!bs.length||bs[0].disabled)return;
  const right=q.ch.indexOf(q.right),ok=k===right,tok=quizTok;
  bs.forEach((x,i)=>{x.disabled=true;if(i===right)x.classList.add('border-emerald-500','text-emerald-500')});
  if(ok){QZ.s++;const m=(QZ.sec==='hanja'?S.items:S.words).find(x=>x.id===q.src.id);if(m)m.learned=true}
  else{bs[k].classList.add('border-rose-500','text-rose-500');QZ.wrong.push(q.src)}
  $('qz-score').textContent=`정답 ${QZ.s}`;save();
  setTimeout(()=>{if(tok!==quizTok)return;if(++QZ.i<QZ.list.length)qzShow();else qzEnd()},ok?700:1400);
}
function qzEnd(){
  show('qz-play',false);show('qz-res',true);
  $('qz-final').textContent=`${QZ.s} / ${QZ.list.length} (${Math.round(QZ.s/QZ.list.length*100)}점)`;const hj=QZ.sec==='hanja';
  $('qz-wrong').innerHTML=QZ.wrong.length?'<div class="font-bold text-slate-400 mb-1">틀린 항목</div>'+QZ.wrong.map(x=>`<div class="p-2.5 rounded-xl border border-slate-200 dark:border-slate-800"><span class="hj font-black text-indigo-500">${esc(hj?x.char:x.word)}</span> ${hj?`<b>${esc(hx(x).m[0]||'')} ${esc(x.sound)}</b>`:`<b>${esc(x.reading)}</b> · ${esc(x.meaning)}`}</div>`).join(''):'<div class="text-center text-emerald-500 font-bold">모두 맞혔어요! 🎉</div>';
  show('qz-retry',QZ.wrong.length>0);
}
function retryWrong(){if(QZ&&QZ.wrong.length)buildQuiz(QZ.sec,shuffle(QZ.wrong),QZ.mode)}

/* ---------- 초기화 (2단계 확인 → 동의하기) ---------- */
async function startReset(){
  const ok=await dlg({title:'모든 데이터 초기화',msg:'저장한 한자, 폴더, 단어, 암기·북마크 기록이 모두 삭제됩니다.\n\n계속 진행할까요?',ok:'계속',danger:true});
  if(!ok)return;
  $('reset-info').innerHTML=`<div>📚 한자 <b>${S.items.length}</b>개</div><div>📂 폴더 <b>${S.folders.length}</b>개</div><div>📝 단어 <b>${S.words.length}</b>개</div><div>🗑️ 휴지통 <b>${S.trash.length}</b>개</div>`;
  $('m-reset').classList.add('open');
}
function doReset(){
  try{localStorage.removeItem(KEY)}catch(e){}
  location.reload();
}

/* ---------- 휴지통 ---------- */
function toTrash(type,data){S.trash.unshift({tid:'t'+Date.now()+Math.random().toString(36).slice(2,6),type,data:JSON.parse(JSON.stringify(data)),at:Date.now()});trashN()}
function trashN(){$('trash-n').textContent=S.trash.length?`(${S.trash.length})`:''}
function openTrash(){renderTrash();$('m-trash').classList.add('open')}
function renderTrash(){
  trashN();
  $('trash-list').innerHTML=S.trash.length?S.trash.map(t=>{
    const d=Math.floor((Date.now()-t.at)/864e5),when=d===0?'오늘':`${d}일 전`,left=Math.max(1,30-d);let tag,label;
    if(t.type==='item'){tag='한자';label=`<span class="hj text-lg text-indigo-500">${esc(t.data.char)}</span> ${esc(t.data.meaning)} ${esc(t.data.sound)}`}
    else if(t.type==='word'){tag='단어';label=`<span class="hj text-indigo-500">${esc(t.data.word)}</span> ${esc(t.data.meaning)}`}
    else{tag='폴더';label=`📂 ${esc(t.data.folder.name)} <span class="text-xs text-slate-400">(한자 ${t.data.itemIds.length}개 포함)</span>`}
    return `<div class="flex items-center justify-between gap-2 p-3 rounded-2xl border border-slate-200 dark:border-slate-800">
      <div class="min-w-0"><div class="text-sm font-bold truncate">${label}</div><div class="text-[11px] text-slate-400">${tag} · ${when} 삭제 · ${left}일 후 자동 삭제</div></div>
      <div class="flex gap-1 shrink-0"><button onclick="restoreTrash('${t.tid}')" class="b grn">복원</button><button onclick="purgeTrash('${t.tid}')" class="b g text-rose-500">영구 삭제</button></div></div>`}).join(''):'<p class="text-center text-xs text-slate-400 py-16">휴지통이 비어 있어요.</p>';
}
function restoreTrash(tid){
  const k=S.trash.findIndex(t=>t.tid===tid);if(k<0)return;const t=S.trash[k];
  if(t.type==='item'){
    if(S.items.some(i=>i.char===t.data.char))return toast('같은 한자가 이미 있어서 복원할 수 없어요.');
    const it={...t.data};if(!S.folders.some(f=>f.id===it.folder))it.folder=S.folders[0].id;S.items.push(it);
  }else if(t.type==='word'){
    if(S.words.some(w=>w.word===t.data.word))return toast('같은 단어가 이미 있어서 복원할 수 없어요.');S.words.push({...t.data});
  }else{
    const{folder,itemIds}=t.data;if(!S.folders.some(f=>f.id===folder.id))S.folders.push({...folder});
    S.items.forEach(i=>{if(itemIds.includes(i.id))i.folder=folder.id});
  }
  S.trash.splice(k,1);save();fillFolders();renderTrash();render();toast('복원했어요.');
}
async function purgeTrash(tid){if(!await dlg({title:'영구 삭제',msg:'이 항목은 다시 복원할 수 없어요. 삭제할까요?',ok:'영구 삭제',danger:true}))return;S.trash=S.trash.filter(t=>t.tid!==tid);save();renderTrash()}
async function emptyTrash(){
  if(!S.trash.length)return toast('휴지통이 비어 있어요.');
  if(!await dlg({title:'휴지통 비우기',msg:`${S.trash.length}개 항목이 영구 삭제되고 복원할 수 없어요.`,ok:'모두 삭제',danger:true}))return;
  S.trash=[];save();renderTrash();toast('휴지통을 비웠어요.');
}

/* ---------- 키보드 ---------- */
document.addEventListener('keydown',e=>{
  if(e.key==='Escape'){
    if($('m-dlg').classList.contains('open')){$('dlg-cancel').click();return}
    const close={'m-detail':closeDetail,'m-wd':closeWd,'m-search':()=>closeM('m-search'),'m-trash':()=>closeM('m-trash'),'m-word':()=>closeM('m-word'),'m-fmenu':()=>closeM('m-fmenu'),'m-reset':()=>closeM('m-reset')};
    for(const id in close)if($(id).classList.contains('open')){close[id]();break}return;
  }
  if(/^[1-4]$/.test(e.key)&&!$('qz-play').classList.contains('hidden')&&!/INPUT|SELECT|TEXTAREA/.test(document.activeElement.tagName)){
    if(QZ&&QZ.list[QZ.i]&&+e.key<=QZ.list[QZ.i].ch.length)qzAns(+e.key-1);
  }
});
$('w-read').addEventListener('input',()=>{readAuto=false});

/* ---------- 시작 ---------- */
if(firstRun){'水木火金土日月山'.split('').forEach(c=>add(DB.find(d=>d.char===c),'f1'));save()}
if(S.dark===false)document.documentElement.classList.remove('dark');
fillFolders();apiBtn();trashN();render();
</script>
