function dlg({title,msg='',input=false,value='',ok='확인',danger=false}){
  return new Promise(res=>{
    $('dlg-title').textContent=title;$('dlg-msg').textContent=msg;$('dlg-msg').classList.toggle('hidden',!msg);
    const inp=$('dlg-inp'),b=$('dlg-ok'),c=$('dlg-cancel'),m=$('m-dlg');
    inp.classList.toggle('hidden',!input);inp.value=value;b.textContent=ok;
    b.className='flex-1 py-2.5 rounded-xl text-white font-bold '+(danger?'bg-rose-600':'bg-indigo-600');
    m.classList.add('open');if(input)setTimeout(()=>inp.focus(),30);
    const done=v=>{m.classList.remove('open');b.onclick=c.onclick=inp.onkeydown=null;res(v)};
    b.onclick=()=>done(input?inp.value:true);c.onclick=()=>done(input?null:false);
    inp.onkeydown=e=>{if(e.key==='Enter')b.click()};
  });
}
