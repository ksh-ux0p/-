let found=[];
function localSearch(q){
  q=q.normalize('NFKC');const cj=q.match(/[㐀-鿿]/g);
  if(cj)return[...new Set(cj)].map(c=>DB.find(d=>d.char===c)).filter(Boolean);
  const vs=dueumVariants(q);
  const rank=d=>{let b=9;const alts=(d.alt||'').split('/');
    vs.forEach((v,k)=>{const p=k?.5:0;if(d.sound===v)b=Math.min(b,p);else if(alts.includes(v))b=Math.min(b,1+p)});
    const ms=d.meaning.split(', ');if(ms.includes(q))b=Math.min(b,2);else if(ms.some(m=>m.startsWith(q)))b=Math.min(b,2.5);else if(d.meaning.includes(q))b=Math.min(b,3);return b};
  return DB.map(d=>[rank(d),d]).filter(x=>x[0]<9).sort((a,b)=>a[0]-b[0]).map(x=>x[1]).slice(0,60);
}
